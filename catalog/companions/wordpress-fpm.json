{
  "schema_version": "1.0.0",
  "id": "wordpress-fpm",
  "name": "Isolated WordPress PHP-FPM + MariaDB 11.8 Companion",
  "category": "companion",
  "version": "7.1.5",
  "summary": "Hardened --read-only WordPress PHP-FPM companion isolated on 127.0.0.1:9000 behind NGINX 1.30.6 HTTP/3 and private MariaDB 11.8.",
  "recommended_edge_proxy": "nginx",
  "required_variables": [
    {
      "name": "WP_IMAGE",
      "description": "WordPress container image (defaults to verified WordPress 7.1.5 LTS FPM Alpine)",
      "required": false,
      "default": "docker.io/library/wordpress:7.1-fpm-alpine@sha256:74fd3fffc4b3b0c40d4cc0803ec40fe1a7febf0437e96d55b9cbc9a4e54a1aae"
    },
    {
      "name": "WP_DB_PASSWORD",
      "description": "WordPress MariaDB 11.8 user password supplied via secret manager",
      "required": true,
      "secret": true
    },
    {
      "name": "WP_MARIADB_ROOT_PASSWORD",
      "description": "MariaDB 11.8 root password for isolated WordPress datastore",
      "required": true,
      "secret": true
    },
    {
      "name": "WP_FPM_PORT",
      "description": "Loopback FastCGI port bound strictly to 127.0.0.1 for NGINX 1.30.6 fastcgi_pass",
      "required": false,
      "default": "9000"
    }
  ],
  "stack": {
    "stack_name": "wordpress-fpm",
    "edge_proxy": "nginx",
    "services": [
      {
        "name": "wordpress-fpm",
        "image": "${WP_IMAGE:-docker.io/library/wordpress:7.1-fpm-alpine@sha256:74fd3fffc4b3b0c40d4cc0803ec40fe1a7febf0437e96d55b9cbc9a4e54a1aae}",
        "container_name": "grabtac-wordpress-fpm",
        "read_only": true,
        "user": "65532:65532",
        "cap_drop": ["ALL"],
        "security_opt": ["no-new-privileges:true"],
        "tmpfs": [
          "/tmp:rw,noexec,nosuid,size=64m",
          "/run/php-fpm:rw,noexec,nosuid,size=16m"
        ],
        "ports": ["127.0.0.1:${WP_FPM_PORT:-9000}:9000"],
        "volumes": [
          "wp-content:/var/www/html/wp-content:rw"
        ],
        "networks": ["grabtac_loopback", "grabtac_internal"],
        "environment": {
          "WORDPRESS_DB_HOST": "wp-mariadb-11-8:3306",
          "WORDPRESS_DB_NAME": "${WP_DB_NAME:-wordpress}",
          "WORDPRESS_DB_PASSWORD": "${WP_DB_PASSWORD:?Set WP_DB_PASSWORD in .env or secret manager}",
          "WORDPRESS_DB_USER": "${WP_DB_USER:-wordpress}"
        },
        "healthcheck": {
          "test": ["CMD-SHELL", "php-fpm -t || exit 1"],
          "interval": "30s",
          "timeout": "5s",
          "retries": 3,
          "start_period": "15s"
        },
        "restart": "unless-stopped"
      },
      {
        "name": "wp-mariadb-11-8",
        "image": "docker.io/library/mariadb:11.8.1@sha256:2f71c8a9d2218c98eb74bc7211100a83a91d7b1e39ce19ab818373a7f244ca4b",
        "container_name": "grabtac-wp-mariadb-11-8",
        "read_only": true,
        "user": "65532:65532",
        "cap_drop": ["ALL"],
        "security_opt": ["no-new-privileges:true"],
        "tmpfs": [
          "/tmp:rw,noexec,nosuid,size=64m",
          "/run/mysqld:rw,noexec,nosuid,size=16m"
        ],
        "ports": ["127.0.0.1:${WP_MARIADB_PORT:-3307}:3306"],
        "volumes": [
          "wp-mariadb-data:/var/lib/mysql:rw"
        ],
        "networks": ["grabtac_internal"],
        "environment": {
          "MARIADB_DATABASE": "${WP_DB_NAME:-wordpress}",
          "MARIADB_PASSWORD": "${WP_DB_PASSWORD:?Set WP_DB_PASSWORD in .env or secret manager}",
          "MARIADB_ROOT_PASSWORD": "${WP_MARIADB_ROOT_PASSWORD:?Set WP_MARIADB_ROOT_PASSWORD in .env or secret manager}",
          "MARIADB_USER": "${WP_DB_USER:-wordpress}"
        },
        "healthcheck": {
          "test": ["CMD-SHELL", "healthcheck.sh --connect --innodb_initialized || exit 1"],
          "interval": "15s",
          "timeout": "5s",
          "retries": 5,
          "start_period": "20s"
        },
        "restart": "unless-stopped",
        "is_data_store": true
      }
    ],
    "volumes": ["wp-content", "wp-mariadb-data"]
  }
}
